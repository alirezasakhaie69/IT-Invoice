# Copy this file to .env and replace every placeholder before `docker compose up`.
# Never commit .env. The app does not print these values.

APP_SECRET_KEY=change-me
ADMIN_USERNAME=change-me
ADMIN_PASSWORD=change-me
BALE_BOT_TOKEN=
TELEGRAM_BOT_TOKEN=
TELEGRAM_PROXY_URL=

# Non-secret defaults. Change the public URL if you are not on localhost.
BALE_API_BASE=https://tapi.bale.ai
TELEGRAM_API_BASE=https://api.telegram.org
APP_BASE_URL=http://localhost:9050
DATA_DIR=/data
